   "accessGroups": [
    {
     "name": "Servicedesk"
    }
   ],
   "task": {
    "script": "try {\n    $user = $form.gridUsers\n    Set-ADUser -Identity $user.ObjectGuid -AccountExpirationDate $form.expireDate -ErrorAction Stop\n    Write-Information -Tags \"Audit\" -MessageData @{ Action = \"UpdateAccount\"; System = \"ActiveDirectory\"; Message = \"Expiry set for $($user.DisplayName)\"; IsError = $false; TargetDisplayName = $user.DisplayName; TargetIdentifier = $user.ObjectGuid }\n} catch {\n    Write-Error \"Setting expiry failed: $($_.Exception.Message)\"\n}",
    "runInCloud": false,
    "agentPoolId": "00000000-5a00-4000-8000-000000000900"
   }
  },
  {
   "delegatedFormGUID": "00000000-5a00-4000-8000-000000000202",
   "name": "Groepslidmaatschap beheren",
   "dynamicFormGUID": "00000000-5a00-4000-8000-000000000102",
   "isEnabled": true,
   "categoryGuids": [
    "00000000-5a00-4000-8000-000000000800"
   ],
   "accessGroups": [
    {
     "name": "Servicedesk"
    },
    {
     "name": "Teamleiders"
    }
   ],
   "task": {
    "script": "$user = $form.gridUsers\nforeach ($g in $form.groupsToAdd.right) {\n    try {\n        Add-ADGroupMember -Identity $g.Name -Members $user.ObjectGuid\n        Write-Host \"Added $($user.DisplayName) to $($g.Name)\"\n    } catch { }\n}",
    "runInCloud": false,
    "agentPoolId": "00000000-5a00-4000-8000-000000000900"
   }
  },
  {
