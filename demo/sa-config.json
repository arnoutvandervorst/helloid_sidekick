   ],
   "accessGroups": [
    {
     "name": "Servicedesk"
    }
   ],
   "task": {
    "script": "try {\n    $user = $form.gridUsers\n    $new = ConvertTo-SecureString \"Welkom2026!\" -AsPlainText -Force\n    Set-ADAccountPassword -Identity $user.ObjectGuid -NewPassword $new -Reset -ErrorAction Stop\n    Set-ADUser -Identity $user.ObjectGuid -ChangePasswordAtLogon $true -ErrorAction Stop\n    Hid-Add-TaskResult -ResultValue \"Password reset for $($form.gridUser.DisplayName)\"\n} catch {\n    Write-Error \"Password reset failed: $($_.Exception.Message)\"\n}",
    "runInCloud": false,
