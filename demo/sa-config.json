 "dataSources": [
  {
   "dataSourceGUID": "00000000-5a00-4000-8000-000000000001",
   "name": "AD - medewerkers zoeken",
   "type": 4,
   "runInCloud": false,
   "script": "try {\n    $searchValue = $datasource.searchValue\n    $users = Get-ADUser -Filter \"Name -like '*$searchValue*'\" -SearchBase $ADusersSearchOU -Properties DisplayName, mail\n    foreach ($u in $users) {\n        Write-Output @{ DisplayName = $u.DisplayName; UserPrincipalName = $u.UserPrincipalName; ObjectGuid = [string]$u.ObjectGuid }\n    }\n} catch {\n    Write-Error \"Searching users failed: $($_.Exception.Message)\"\n}",
   "model": [
    {
     "key": "DisplayName"
    },
    {
     "key": "UserPrincipalName"
    },
    {
     "key": "ObjectGuid"
    }
   ],
   "input": [
    {
     "key": "searchValue"
    }
   ]
  },
  {
   "dataSourceGUID": "00000000-5a00-4000-8000-000000000002",
   "name": "AD - alle groepen",
   "type": 4,
   "runInCloud": false,
   "script": "$groups = Get-ADGroup -Filter * -SearchBase \"OU=Groepen,DC=avo,DC=local\" -Properties Description\nforeach ($g in $groups) { Write-Output @{ Name = $g.Name; Description = $g.Description } }",
   "model": [
    {
     "key": "Name"
    },
    {
     "key": "Description"
    }
   ],
   "input": []
  },
  {
   "dataSourceGUID": "00000000-5a00-4000-8000-000000000003",
   "name": "AD - groepen van medewerker",
   "type": 4,
   "runInCloud": false,
   "script": "try {\n    $user = Get-ADUser -Identity $datasource.selectedUser.ObjectGuid -Properties MemberOf\n    foreach ($dn in $user.MemberOf) {\n        $g = Get-ADGroup -Identity $dn\n        Write-Output @{ Name = $g.Name }\n    }\n} catch {\n    Write-Error \"Reading memberships failed: $($_.Exception.Message)\"\n}",
   "model": [
    {
     "key": "Name"
    }
   ],
   "input": [
    {
     "key": "selectedUser"
    }
   ]
  },
  {
   "dataSourceGUID": "00000000-5a00-4000-8000-000000000004",
   "name": "HR - afdelingen",
   "type": 4,
   "runInCloud": false,
   "script": "try {\n    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls\n    $pair = \"svc_hrlink:Zomer2026!\"\n    $headers = @{ Authorization = \"Basic \" + [Convert]::ToBase64String([Text.Encoding]::ASCII.GetBytes($pair)) }\n    $deps = Invoke-RestMethod -Uri \"$HrApiBase/departments\" -Headers $headers\n    foreach ($d in $deps) { Write-Output @{ code = $d.code; name = $d.name } }\n} catch {\n    Write-Error \"Department list failed: $($_.Exception.Message)\"\n}",
   "model": [
    {
     "key": "code"
    },
    {
     "key": "name"
    }
   ],
   "input": []
  },
  {
   "dataSourceGUID": "00000000-5a00-4000-8000-000000000005",
   "name": "AD - medewerker controleren",
   "type": 4,
   "runInCloud": false,
   "script": "try {\n    $u = Get-ADUser -Identity $datasource.selectedUser.ObjectGuid\n    Set-ADUser -Identity $u -Replace @{ extensionAttribute9 = (Get-Date).ToString(\"s\") }\n    Write-Output @{ ObjectGuid = [string]$u.ObjectGuid; Checked = $true }\n} catch {\n    Write-Error \"Lookup failed: $($_.Exception.Message)\"\n}",
   "model": [
    {
     "key": "ObjectGuid"
    },
    {
     "key": "Checked"
    }
   ],
   "input": [
    {
     "key": "selectedUser"
    }
   ]
  }
 ],
