# Exports stay out of the repo — they carry account, person and contract data.
# demo/ is the exception: generated by make-demo-set.py, invented from end to end.
*.csv
vault*.json
Vault*.json
*-vault.json

!demo/*.csv
!demo/*.json

# Build output; build.py regenerates it.
dist/

# Tenant credentials for the collectors. Never commit; .env.example is the template for the
# environment fallback, helloid-config.json holds the saved profiles (owner-only).
.env
helloid-config.json
helloid-config.json.tmp

# Exports pulled from a live tenant.
/product-assignments.csv
/products.json
helloid-service-automation*.json

# Collector output — real directories carry personal data. demo/ stays the exception.
directory*.json

# The audit log pulled from a tenant (helloid-audit.py): names, decisions, logins.
helloid-audit*.json

# Deployment notes for a specific host: hostnames, users and internal addresses.
deploy-local/
DEPLOY-NUC.md

# Session state and OS noise
.remember/
.DS_Store

# Python bytecode.
__pycache__/
*.pyc
# dashboard bundles the partner publishes: customer data
published/
